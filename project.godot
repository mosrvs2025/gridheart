; Gridheart - project configuration.

config_version=5

[application]

config/name="Gridheart"
config/description="A top-down pixel-art action roguelite where health is a grid and weapons are shapes."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon.png"
boot_splash/bg_color=Color(0.1, 0.08, 0.13, 1)
boot_splash/show_image=false

[autoload]

Art="*res://scripts/systems/art.gd"
Sfx="*res://scripts/systems/audio.gd"
Controls="*res://scripts/systems/controls.gd"
Run="*res://scripts/systems/run_manager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="prop"
2d_physics/layer_5="projectile"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.1, 0.08, 0.13, 1)
anti_aliasing/quality/msaa_2d=0

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=0.0
